//@version=6
// =====================================================================
// V46 EX-ANTE BIAS LAB  (Phase 2)
//
// Six candidate directional models on ONE sweep event stream. Every input is
// closed before the decision bar (request.security ... [1], lookahead_off), so
// each can answer "at 09:42, before knowing what happens next, my bias is X".
//
//   B0 control        always aligned (the null)
//   B1 HTF trend      4H EMA20 vs EMA50
//   B2 HTF structure  4H swing break, persists until flipped
//   B3 daily          prev-day direction + position vs prev-day midpoint
//   B4 displacement   sign of the last >=1.5xATR 4H bar, valid 12 bars
//   B5 composite      B1 and B2 must agree
//
// Neutral means NO TRADE. Abstention is measured, not hidden.
// Fold is selected by input; fold C stays sealed until the spec is frozen.
// Spec: PHASE2_PROTOCOL.md (committed before this ran).
// =====================================================================
indicator("V46 BIAS LAB", overlay=true)

dirMode  = input.int(1,  "direction 1=long -1=short", minval=-1, maxval=1, group="Test")
foldSel  = input.int(3,  "fold 0=A 1=B 2=C(SEALED) 3=A+B 4=all", minval=0, maxval=4, group="Test")
roomOn   = input.bool(true,  "room filter on", group="Test")
roomMin  = input.float(10.0, "min room to destination (R)", group="Test")
tgtR     = input.float(5.0,  "target (R)", group="Test")
bufATR   = input.float(0.20, "stop buffer (xATR)", group="Setup")
minWick  = input.float(0.10, "min sweep beyond level (xATR)", group="Setup")
retBars  = input.int(24,  "retest window (bars)", group="Setup")
minRatr  = input.float(0.05, "min R (xATR)", group="Setup")
maxRatr  = input.float(3.00, "max R (xATR)", group="Setup")
maxBars  = input.int(144, "timeout bars", group="Setup")
costUSD  = input.float(3.00, "execution drag ($)", group="Setup")
swLen    = input.int(10,  "swing pivot len", group="Levels")

FA = 1782086400000
FB = 1784160000000
FC = 1786233600000
FE = 1788134400000
inFold = foldSel == 0 ? (time < FB) : foldSel == 1 ? (time >= FB and time < FC) : foldSel == 2 ? (time >= FC and time < FE) : foldSel == 3 ? (time < FC) : (time < FE)

atr = ta.atr(14)
isLong = dirMode == 1

// ---------- B1: 4H EMA trend ----------
hE20 = request.security(syminfo.tickerid, "240", ta.ema(close, 20)[1], lookahead=barmerge.lookahead_off)
hE50 = request.security(syminfo.tickerid, "240", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)
b1 = na(hE20) or na(hE50) ? 0 : (hE20 > hE50 ? 1 : -1)

// ---------- B2: 4H swing structure ----------
f_struct() =>
    ph = ta.pivothigh(high, 3, 3)
    pl = ta.pivotlow(low, 3, 3)
    var float lastPH = na
    var float lastPL = na
    if not na(ph)
        lastPH := ph
    if not na(pl)
        lastPL := pl
    var int d = 0
    if not na(lastPH) and close > lastPH
        d := 1
    if not na(lastPL) and close < lastPL
        d := -1
    d
b2 = nz(request.security(syminfo.tickerid, "240", f_struct()[1], lookahead=barmerge.lookahead_off), 0)

// ---------- B3: previous-day structure ----------
pdO = request.security(syminfo.tickerid, "D", open[1],  lookahead=barmerge.lookahead_off)
pdC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
pdH = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_off)
pdL = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_off)
pdMid = na(pdH) or na(pdL) ? na : (pdH + pdL) / 2.0
b3 = na(pdMid) or na(pdO) or na(pdC) ? 0 : (pdC > pdO and close > pdMid ? 1 : pdC < pdO and close < pdMid ? -1 : 0)

// ---------- B4: 4H displacement ----------
f_disp() =>
    a = ta.atr(14)
    rg = high - low
    var int d = 0
    var int age = 999
    if not na(a) and rg >= 1.5 * a
        d := close > open ? 1 : -1
        age := 0
    else
        age := age + 1
    age <= 12 ? d : 0
b4 = nz(request.security(syminfo.tickerid, "240", f_disp()[1], lookahead=barmerge.lookahead_off), 0)

// ---------- B5: composite ----------
b5 = b1 != 0 and b1 == b2 ? b1 : 0

want = isLong ? 1 : -1
aligned(g) => g == 0 ? true : g == 1 ? b1 == want : g == 2 ? b2 == want : g == 3 ? b3 == want : g == 4 ? b4 == want : b5 == want

// ---------- levels ----------
newD = ta.change(time("D")) != 0
var float pdh = na
var float pdl = na
var float dh  = na
var float dl  = na
if newD
    pdh := dh
    pdl := dl
    dh  := high
    dl  := low
else
    dh := math.max(nz(dh, high), high)
    dl := math.min(nz(dl, low), low)

hUTC = hour(time, "UTC")
inAsia = hUTC < 7
var float asiaH = na
var float asiaL = na
var bool  asiaOn = false
if inAsia and not asiaOn
    asiaOn := true
    asiaH := high
    asiaL := low
else if inAsia
    asiaH := math.max(nz(asiaH, high), high)
    asiaL := math.min(nz(asiaL, low), low)
else
    asiaOn := false

ph5 = ta.pivothigh(high, swLen, swLen)
pl5 = ta.pivotlow(low,  swLen, swLen)
var float swH = na
var float swL = na
if not na(ph5)
    swH := ph5
if not na(pl5)
    swL := pl5

gotSweep = false
float sLvl = na
if not na(atr) and atr > 0
    if isLong
        if not na(pdl) and low < pdl - minWick * atr and close > pdl
            gotSweep := true
            sLvl := pdl
        else if not na(asiaL) and low < asiaL - minWick * atr and close > asiaL
            gotSweep := true
            sLvl := asiaL
        else if not na(swL) and low < swL - minWick * atr and close > swL
            gotSweep := true
            sLvl := swL
    else
        if not na(pdh) and high > pdh + minWick * atr and close < pdh
            gotSweep := true
            sLvl := pdh
        else if not na(asiaH) and high > asiaH + minWick * atr and close < asiaH
            gotSweep := true
            sLvl := asiaH
        else if not na(swH) and high > swH + minWick * atr and close < swH
            gotSweep := true
            sLvl := swH

nearestAbove(px) =>
    float b = na
    if not na(pdh) and pdh > px
        b := pdh
    if not na(asiaH) and asiaH > px
        b := na(b) ? asiaH : math.min(b, asiaH)
    if not na(swH) and swH > px
        b := na(b) ? swH : math.min(b, swH)
    b
nearestBelow(px) =>
    float b = na
    if not na(pdl) and pdl < px
        b := pdl
    if not na(asiaL) and asiaL < px
        b := na(b) ? asiaL : math.max(b, asiaL)
    if not na(swL) and swL < px
        b := na(b) ? swL : math.max(b, swL)
    b

// ---------- engine ----------
SP = 2
NG = 6
TOT = 12
var int[]   st   = array.new_int(TOT, 0)
var float[] lvl  = array.new_float(TOT, na)
var float[] stp  = array.new_float(TOT, na)
var float[] ent  = array.new_float(TOT, na)
var float[] rr   = array.new_float(TOT, na)
var float[] aRf  = array.new_float(TOT, na)
var int[]   wt   = array.new_int(TOT, 0)
var int[]   bIn  = array.new_int(TOT, 0)
var float[] mfe  = array.new_float(TOT, 0.0)
var float[] mae  = array.new_float(TOT, 0.0)
var int[]   flg  = array.new_int(TOT, 0)

var int[]   cN   = array.new_int(NG, 0)
var int[]   cW   = array.new_int(NG, 0)
var float[] cSum = array.new_float(NG, 0.0)
var float[] cWin = array.new_float(NG, 0.0)
var float[] cLos = array.new_float(NG, 0.0)
var float[] cMFE = array.new_float(NG, 0.0)
var float[] cMAE = array.new_float(NG, 0.0)
var int[]   cArm = array.new_int(NG, 0)
var int   foldBars = 0
var int   sweepN   = 0
if inFold
    foldBars += 1
    if gotSweep
        sweepN += 1

ptv = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

record(i) =>
    g  = int(math.floor(i / SP))
    r  = array.get(rr, i)
    cR = costUSD / (r * ptv)
    v  = (array.get(flg, i) >= 1 ? tgtR : -1.0) - cR
    array.set(cN, g, array.get(cN, g) + 1)
    array.set(cSum, g, array.get(cSum, g) + v)
    array.set(cMFE, g, array.get(cMFE, g) + array.get(mfe, i))
    array.set(cMAE, g, array.get(cMAE, g) + array.get(mae, i))
    if v > 0
        array.set(cW, g, array.get(cW, g) + 1)
        array.set(cWin, g, array.get(cWin, g) + v)
    else
        array.set(cLos, g, array.get(cLos, g) + v)
    array.set(st, i, 0)

for i = 0 to TOT - 1
    if array.get(st, i) == 2
        e = array.get(ent, i)
        r = array.get(rr, i)
        b = array.get(bIn, i) + 1
        array.set(bIn, i, b)
        adv = isLong ? (e - low) / r  : (high - e) / r
        fav = isLong ? (high - e) / r : (e - low) / r
        if adv > array.get(mae, i)
            array.set(mae, i, adv)
        if adv >= 1.0
            record(i)
        else
            if fav > array.get(mfe, i)
                array.set(mfe, i, fav)
            if fav >= tgtR
                array.set(flg, i, 1)
                record(i)
            else if b >= maxBars
                record(i)

for i = 0 to TOT - 1
    if array.get(st, i) == 1
        L  = array.get(lvl, i)
        sp = array.get(stp, i)
        hit = isLong ? low <= L : high >= L
        if hit
            r = math.abs(L - sp)
            a = array.get(aRf, i)
            ratio = r / a
            tgt = isLong ? nearestAbove(L) : nearestBelow(L)
            room = na(tgt) or r <= 0 ? na : math.abs(tgt - L) / r
            roomOK = not roomOn or (not na(room) and room >= roomMin)
            if ratio >= minRatr and ratio <= maxRatr and roomOK
                array.set(st, i, 2)
                array.set(ent, i, L)
                array.set(rr, i, r)
                array.set(bIn, i, 0)
                array.set(mfe, i, 0.0)
                array.set(mae, i, 0.0)
                array.set(flg, i, 0)
            else
                array.set(st, i, 0)
        else
            w = array.get(wt, i) + 1
            array.set(wt, i, w)
            if w >= retBars
                array.set(st, i, 0)

arm(g, entLvl, stpLvl) =>
    array.set(cArm, g, array.get(cArm, g) + 1)
    int fr = -1
    for s = 0 to SP - 1
        if fr < 0 and array.get(st, g * SP + s) == 0
            fr := g * SP + s
    if fr >= 0
        array.set(st, fr, 1)
        array.set(lvl, fr, entLvl)
        array.set(stp, fr, stpLvl)
        array.set(aRf, fr, atr)
        array.set(wt, fr, 0)

if inFold and gotSweep and not na(atr) and atr > 0
    sp = isLong ? low - bufATR * atr : high + bufATR * atr
    for g = 0 to NG - 1
        if aligned(g)
            arm(g, sLvl, sp)

glbl(g) => g == 0 ? "B0 control" : g == 1 ? "B1 4H trend" : g == 2 ? "B2 4H struct" : g == 3 ? "B3 prev-day" : g == 4 ? "B4 disp" : "B5 B1&B2"
foldName = foldSel == 0 ? "A develop" : foldSel == 1 ? "B validate" : foldSel == 2 ? "C TEST" : foldSel == 3 ? "A+B" : "ALL"

var table tb = table.new(position.top_right, 9, 10, border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, (isLong ? "V46 BIAS L " : "V46 BIAS S ") + foldName, text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 1, 0, "armed", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 2, 0, "n",     text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 3, 0, "E[R]",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 4, 0, "win%",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 5, 0, "PF",    text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 6, 0, "keep%", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 7, 0, "MFE",   text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 8, 0, "/day",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    days = math.max(1.0, foldBars / 288.0)
    for g = 0 to NG - 1
        n = array.get(cN, g)
        table.cell(tb, 0, g + 1, glbl(g), text_size=size.tiny)
        table.cell(tb, 1, g + 1, str.tostring(array.get(cArm, g)), text_size=size.tiny)
        table.cell(tb, 2, g + 1, str.tostring(n), text_size=size.tiny)
        table.cell(tb, 6, g + 1, sweepN > 0 ? str.tostring(100.0 * array.get(cArm, g) / sweepN, "#.#") : "-", text_size=size.tiny)
        if n > 0
            e = array.get(cSum, g) / n
            gl = math.abs(array.get(cLos, g))
            table.cell(tb, 3, g + 1, str.tostring(e, "#.###"), text_size=size.tiny, bgcolor=e > 0 ? color.new(color.green, 50) : color.new(color.red, 50))
            table.cell(tb, 4, g + 1, str.tostring(100.0 * array.get(cW, g) / n, "#.#"), text_size=size.tiny)
            table.cell(tb, 5, g + 1, gl > 0 ? str.tostring(array.get(cWin, g) / gl, "#.##") : "-", text_size=size.tiny)
            table.cell(tb, 7, g + 1, str.tostring(array.get(cMFE, g) / n, "#.##"), text_size=size.tiny)
            table.cell(tb, 8, g + 1, str.tostring(n / days, "#.##"), text_size=size.tiny)
    table.cell(tb, 0, 8, syminfo.ticker + " " + timeframe.period, text_size=size.tiny)
    table.cell(tb, 1, 8, "bars " + str.tostring(foldBars), text_size=size.tiny)
    table.cell(tb, 2, 8, "sweeps " + str.tostring(sweepN), text_size=size.tiny)
    table.cell(tb, 3, 8, roomOn ? "room ON" : "room OFF", text_size=size.tiny)
