//@version=6
// V47 PHASE-4 ABLATION -- spec: PHASE2_PROTOCOL.md sec 4. Bias frozen = B1 (4H EMA20/50).
// Room is an explicit per-group switch (the V44 defect). Reclaim and displacement
// arm the trade on the bar they first become true within 12 bars of the sweep,
// rather than requiring them on the sweep bar itself.
//   g0 sweep only            g4 bias+disp
//   g1 bias                  g5 bias+reclaim
//   g2 room                  g6 bias+room+disp
//   g3 bias+room             g7 full: bias+room+reclaim+disp
indicator("V47 ABLATION", overlay=true)

dirMode  = input.int(1,  "direction 1=long -1=short", minval=-1, maxval=1, group="Test")
foldSel  = input.int(3,  "fold 0=A 1=B 2=C(SEALED) 3=A+B 4=all", minval=0, maxval=4, group="Test")
roomMin  = input.float(10.0, "min room (R)", group="Test")
tgtR     = input.float(5.0,  "target (R)", group="Test")
bufATR   = input.float(0.20, "stop buffer (xATR)", group="Setup")
minWick  = input.float(0.10, "min sweep (xATR)", group="Setup")
recATR   = input.float(0.25, "reclaim (xATR)", group="Setup")
dispMin  = input.float(1.50, "displacement (xATR)", group="Setup")
waitBars = input.int(12,  "confirmation window", group="Setup")
retBars  = input.int(24,  "retest window", group="Setup")
minRatr  = input.float(0.05, "min R (xATR)", group="Setup")
maxRatr  = input.float(3.00, "max R (xATR)", group="Setup")
maxBars  = input.int(144, "timeout bars", group="Setup")
costUSD  = input.float(3.00, "drag ($)", group="Setup")
swLen    = input.int(10,  "swing pivot len", group="Levels")

FB = 1784160000000
FC = 1786233600000
FE = 1788134400000
inFold = foldSel == 0 ? (time < FB) : foldSel == 1 ? (time >= FB and time < FC) : foldSel == 2 ? (time >= FC and time < FE) : foldSel == 3 ? (time < FC) : (time < FE)

atr = ta.atr(14)
isLong = dirMode == 1
hE20 = request.security(syminfo.tickerid, "240", ta.ema(close, 20)[1], lookahead=barmerge.lookahead_off)
hE50 = request.security(syminfo.tickerid, "240", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)
biasUp = not na(hE20) and not na(hE50) and hE20 > hE50
biasOK = isLong ? biasUp : not biasUp

newD = ta.change(time("D")) != 0
var float pdh = na
var float pdl = na
var float dh  = na
var float dl  = na
if newD
    pdh := dh
    pdl := dl
    dh  := high
    dl  := low
else
    dh := math.max(nz(dh, high), high)
    dl := math.min(nz(dl, low), low)

hUTC = hour(time, "UTC")
inAsia = hUTC < 7
var float asiaH = na
var float asiaL = na
var bool  asiaOn = false
if inAsia and not asiaOn
    asiaOn := true
    asiaH := high
    asiaL := low
else if inAsia
    asiaH := math.max(nz(asiaH, high), high)
    asiaL := math.min(nz(asiaL, low), low)
else
    asiaOn := false

ph5 = ta.pivothigh(high, swLen, swLen)
pl5 = ta.pivotlow(low,  swLen, swLen)
var float swH = na
var float swL = na
if not na(ph5)
    swH := ph5
if not na(pl5)
    swL := pl5

gotSweep = false
float sLvl = na
if not na(atr) and atr > 0
    if isLong
        if not na(pdl) and low < pdl - minWick * atr and close > pdl
            gotSweep := true
            sLvl := pdl
        else if not na(asiaL) and low < asiaL - minWick * atr and close > asiaL
            gotSweep := true
            sLvl := asiaL
        else if not na(swL) and low < swL - minWick * atr and close > swL
            gotSweep := true
            sLvl := swL
    else
        if not na(pdh) and high > pdh + minWick * atr and close < pdh
            gotSweep := true
            sLvl := pdh
        else if not na(asiaH) and high > asiaH + minWick * atr and close < asiaH
            gotSweep := true
            sLvl := asiaH
        else if not na(swH) and high > swH + minWick * atr and close < swH
            gotSweep := true
            sLvl := swH

nearestAbove(px) =>
    float b = na
    if not na(pdh) and pdh > px
        b := pdh
    if not na(asiaH) and asiaH > px
        b := na(b) ? asiaH : math.min(b, asiaH)
    if not na(swH) and swH > px
        b := na(b) ? swH : math.min(b, swH)
    b
nearestBelow(px) =>
    float b = na
    if not na(pdl) and pdl < px
        b := pdl
    if not na(asiaL) and asiaL < px
        b := na(b) ? asiaL : math.max(b, asiaL)
    if not na(swL) and swL < px
        b := na(b) ? swL : math.max(b, swL)
    b

SP = 2
NG = 8
TOT = 16
var int[]   st   = array.new_int(TOT, 0)
var float[] lvl  = array.new_float(TOT, na)
var float[] stp  = array.new_float(TOT, na)
var float[] ent  = array.new_float(TOT, na)
var float[] rr   = array.new_float(TOT, na)
var float[] aRf  = array.new_float(TOT, na)
var int[]   wt   = array.new_int(TOT, 0)
var int[]   bIn  = array.new_int(TOT, 0)
var float[] mfe  = array.new_float(TOT, 0.0)
var float[] mae  = array.new_float(TOT, 0.0)
var int[]   flg  = array.new_int(TOT, 0)

var int[]   cN   = array.new_int(NG, 0)
var int[]   cW   = array.new_int(NG, 0)
var float[] cSum = array.new_float(NG, 0.0)
var float[] cWin = array.new_float(NG, 0.0)
var float[] cLos = array.new_float(NG, 0.0)
var float[] cMFE = array.new_float(NG, 0.0)
var int[]   cArm = array.new_int(NG, 0)
var int   foldBars = 0
var int   sweepN   = 0
if inFold
    foldBars += 1
    if gotSweep
        sweepN += 1

roomReq(g) => g == 2 or g == 3 or g == 6 or g == 7
ptv = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

record(i) =>
    g  = int(math.floor(i / SP))
    r  = array.get(rr, i)
    cR = costUSD / (r * ptv)
    v  = (array.get(flg, i) >= 1 ? tgtR : -1.0) - cR
    array.set(cN, g, array.get(cN, g) + 1)
    array.set(cSum, g, array.get(cSum, g) + v)
    array.set(cMFE, g, array.get(cMFE, g) + array.get(mfe, i))
    if v > 0
        array.set(cW, g, array.get(cW, g) + 1)
        array.set(cWin, g, array.get(cWin, g) + v)
    else
        array.set(cLos, g, array.get(cLos, g) + v)
    array.set(st, i, 0)

for i = 0 to TOT - 1
    if array.get(st, i) == 2
        e = array.get(ent, i)
        r = array.get(rr, i)
        b = array.get(bIn, i) + 1
        array.set(bIn, i, b)
        adv = isLong ? (e - low) / r  : (high - e) / r
        fav = isLong ? (high - e) / r : (e - low) / r
        if adv > array.get(mae, i)
            array.set(mae, i, adv)
        if adv >= 1.0
            record(i)
        else
            if fav > array.get(mfe, i)
                array.set(mfe, i, fav)
            if fav >= tgtR
                array.set(flg, i, 1)
                record(i)
            else if b >= maxBars
                record(i)

for i = 0 to TOT - 1
    if array.get(st, i) == 1
        g  = int(math.floor(i / SP))
        L  = array.get(lvl, i)
        sp = array.get(stp, i)
        hit = isLong ? low <= L : high >= L
        if hit
            r = math.abs(L - sp)
            a = array.get(aRf, i)
            ratio = r / a
            tgt = isLong ? nearestAbove(L) : nearestBelow(L)
            room = na(tgt) or r <= 0 ? na : math.abs(tgt - L) / r
            roomOK = not roomReq(g) or (not na(room) and room >= roomMin)
            if ratio >= minRatr and ratio <= maxRatr and roomOK
                array.set(st, i, 2)
                array.set(ent, i, L)
                array.set(rr, i, r)
                array.set(bIn, i, 0)
                array.set(mfe, i, 0.0)
                array.set(mae, i, 0.0)
                array.set(flg, i, 0)
            else
                array.set(st, i, 0)
        else
            w = array.get(wt, i) + 1
            array.set(wt, i, w)
            if w >= retBars
                array.set(st, i, 0)

arm(g, entLvl, stpLvl, aRef) =>
    array.set(cArm, g, array.get(cArm, g) + 1)
    int fr = -1
    for s = 0 to SP - 1
        if fr < 0 and array.get(st, g * SP + s) == 0
            fr := g * SP + s
    if fr >= 0
        array.set(st, fr, 1)
        array.set(lvl, fr, entLvl)
        array.set(stp, fr, stpLvl)
        array.set(aRf, fr, aRef)
        array.set(wt, fr, 0)

var float sLvlM = na
var float sStop = na
var float sAtr  = na
var int   sBar  = -99999
var bool  sBias = false
var bool  hRec  = false
var bool  hDsp  = false
var bool  aRec  = false
var bool  aDsp  = false
var bool  aFul  = false

if inFold and gotSweep and not na(atr) and atr > 0
    sLvlM := sLvl
    sStop := isLong ? low - bufATR * atr : high + bufATR * atr
    sAtr  := atr
    sBar  := bar_index
    sBias := biasOK
    hRec  := false
    hDsp  := false
    aRec  := false
    aDsp  := false
    aFul  := false
    arm(0, sLvl, sStop, atr)
    if biasOK
        arm(1, sLvl, sStop, atr)
    arm(2, sLvl, sStop, atr)
    if biasOK
        arm(3, sLvl, sStop, atr)

if inFold and not na(sLvlM) and not na(atr) and bar_index - sBar <= waitBars
    rng = high - low
    recNow = isLong ? close > sLvlM + recATR * sAtr : close < sLvlM - recATR * sAtr
    dspNow = rng >= dispMin * sAtr and (isLong ? close > low + 0.6 * rng : close < low + 0.4 * rng)
    if recNow
        hRec := true
    if dspNow
        hDsp := true
    if sBias and hDsp and not aDsp
        aDsp := true
        arm(4, sLvlM, sStop, sAtr)
        arm(6, sLvlM, sStop, sAtr)
    if sBias and hRec and not aRec
        aRec := true
        arm(5, sLvlM, sStop, sAtr)
    if sBias and hRec and hDsp and not aFul
        aFul := true
        arm(7, sLvlM, sStop, sAtr)

glbl(g) => g == 0 ? "1 sweep only" : g == 1 ? "2 +bias" : g == 2 ? "3 +room" : g == 3 ? "4 +bias+room" : g == 4 ? "5 +bias+disp" : g == 5 ? "6 +bias+recl" : g == 6 ? "7 +b+room+disp" : "8 FULL"
foldName = foldSel == 0 ? "A" : foldSel == 1 ? "B" : foldSel == 2 ? "C TEST" : foldSel == 3 ? "A+B" : "ALL"

var table tb = table.new(position.top_right, 8, 12, border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, (isLong ? "V47 ABL L " : "V47 ABL S ") + foldName, text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 1, 0, "armed", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 2, 0, "n",     text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 3, 0, "E[R]",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 4, 0, "win%",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 5, 0, "PF",    text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 6, 0, "MFE",   text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 7, 0, "/day",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    days = math.max(1.0, foldBars / 288.0)
    for g = 0 to NG - 1
        n = array.get(cN, g)
        table.cell(tb, 0, g + 1, glbl(g), text_size=size.tiny)
        table.cell(tb, 1, g + 1, str.tostring(array.get(cArm, g)), text_size=size.tiny)
        table.cell(tb, 2, g + 1, str.tostring(n), text_size=size.tiny)
        if n > 0
            e = array.get(cSum, g) / n
            gl = math.abs(array.get(cLos, g))
            table.cell(tb, 3, g + 1, str.tostring(e, "#.###"), text_size=size.tiny, bgcolor=e > 0 ? color.new(color.green, 50) : color.new(color.red, 50))
            table.cell(tb, 4, g + 1, str.tostring(100.0 * array.get(cW, g) / n, "#.#"), text_size=size.tiny)
            table.cell(tb, 5, g + 1, gl > 0 ? str.tostring(array.get(cWin, g) / gl, "#.##") : "-", text_size=size.tiny)
            table.cell(tb, 6, g + 1, str.tostring(array.get(cMFE, g) / n, "#.##"), text_size=size.tiny)
            table.cell(tb, 7, g + 1, str.tostring(n / days, "#.##"), text_size=size.tiny)
    table.cell(tb, 0, 10, syminfo.ticker + " " + timeframe.period, text_size=size.tiny)
    table.cell(tb, 1, 10, "bars " + str.tostring(foldBars), text_size=size.tiny)
    table.cell(tb, 2, 10, "sweeps " + str.tostring(sweepN), text_size=size.tiny)
