//@version=6
// V48 CANDIDATE LEDGER + ROOM BUCKETS  (Phases 3, 4, 7, 8)
// One detection stream, NO room floor, NO bias filter. Records what happens to
// every candidate, and buckets the fills by available room so the minimum useful
// room threshold can be read off instead of assumed.
// Slots raised to 8 so contention is measured rather than silently suppressing.
indicator("V48 LEDGER", overlay=true)

dirMode  = input.int(1,  "direction 1=long -1=short", minval=-1, maxval=1, group="Test")
foldSel  = input.int(3,  "fold 0=A 1=B 2=C 3=A+B 4=all", minval=0, maxval=4, group="Test")
tgtR     = input.float(5.0,  "target (R)", group="Setup")
bufATR   = input.float(0.20, "stop buffer (xATR)", group="Setup")
minWick  = input.float(0.10, "min sweep (xATR)", group="Setup")
retBars  = input.int(24,  "retest window", group="Setup")
minRatr  = input.float(0.05, "min R (xATR)", group="Setup")
maxRatr  = input.float(3.00, "max R (xATR)", group="Setup")
maxBars  = input.int(144, "timeout bars", group="Setup")
costUSD  = input.float(3.00, "drag ($)", group="Setup")
swLen    = input.int(10,  "swing pivot len", group="Levels")

FB = 1784160000000
FC = 1786233600000
FE = 1788134400000
inFold = foldSel == 0 ? (time < FB) : foldSel == 1 ? (time >= FB and time < FC) : foldSel == 2 ? (time >= FC and time < FE) : foldSel == 3 ? (time < FC) : (time < FE)

atr = ta.atr(14)
isLong = dirMode == 1

newD = ta.change(time("D")) != 0
var float pdh = na
var float pdl = na
var float dh  = na
var float dl  = na
if newD
    pdh := dh
    pdl := dl
    dh  := high
    dl  := low
else
    dh := math.max(nz(dh, high), high)
    dl := math.min(nz(dl, low), low)

hUTC = hour(time, "UTC")
inAsia = hUTC < 7
var float asiaH = na
var float asiaL = na
var bool  asiaOn = false
if inAsia and not asiaOn
    asiaOn := true
    asiaH := high
    asiaL := low
else if inAsia
    asiaH := math.max(nz(asiaH, high), high)
    asiaL := math.min(nz(asiaL, low), low)
else
    asiaOn := false

ph5 = ta.pivothigh(high, swLen, swLen)
pl5 = ta.pivotlow(low,  swLen, swLen)
var float swH = na
var float swL = na
if not na(ph5)
    swH := ph5
if not na(pl5)
    swL := pl5

// ---- detection: first-match cascade (unchanged), plus a count of the
//      simultaneous sweeps the cascade suppresses
hitPD = false
hitAS = false
hitSW = false
if not na(atr) and atr > 0
    if isLong
        hitPD := not na(pdl) and low < pdl - minWick * atr and close > pdl
        hitAS := not na(asiaL) and low < asiaL - minWick * atr and close > asiaL
        hitSW := not na(swL) and low < swL - minWick * atr and close > swL
    else
        hitPD := not na(pdh) and high > pdh + minWick * atr and close < pdh
        hitAS := not na(asiaH) and high > asiaH + minWick * atr and close < asiaH
        hitSW := not na(swH) and high > swH + minWick * atr and close < swH
nHit = (hitPD ? 1 : 0) + (hitAS ? 1 : 0) + (hitSW ? 1 : 0)
gotSweep = nHit > 0
float sLvl = na
if hitPD
    sLvl := isLong ? pdl : pdh
else if hitAS
    sLvl := isLong ? asiaL : asiaH
else if hitSW
    sLvl := isLong ? swL : swH

nearestAbove(px) =>
    float b = na
    if not na(pdh) and pdh > px
        b := pdh
    if not na(asiaH) and asiaH > px
        b := na(b) ? asiaH : math.min(b, asiaH)
    if not na(swH) and swH > px
        b := na(b) ? swH : math.min(b, swH)
    b
nearestBelow(px) =>
    float b = na
    if not na(pdl) and pdl < px
        b := pdl
    if not na(asiaL) and asiaL < px
        b := na(b) ? asiaL : math.max(b, asiaL)
    if not na(swL) and swL < px
        b := na(b) ? swL : math.max(b, swL)
    b

SP = 8
var int[]   st   = array.new_int(SP, 0)
var float[] lvl  = array.new_float(SP, na)
var float[] stp  = array.new_float(SP, na)
var float[] ent  = array.new_float(SP, na)
var float[] rr   = array.new_float(SP, na)
var float[] aRf  = array.new_float(SP, na)
var float[] rmB  = array.new_float(SP, na)
var int[]   wt   = array.new_int(SP, 0)
var int[]   bIn  = array.new_int(SP, 0)
var float[] mfe  = array.new_float(SP, 0.0)
var float[] mae  = array.new_float(SP, 0.0)
var int[]   flg  = array.new_int(SP, 0)

NB = 9
var int[]   bN   = array.new_int(NB, 0)
var int[]   bW   = array.new_int(NB, 0)
var float[] bSum = array.new_float(NB, 0.0)
var float[] bMFE = array.new_float(NB, 0.0)
var float[] bMAE = array.new_float(NB, 0.0)

var int cSweep = 0
var int cExtra = 0
var int cDrop8 = 0
var int cWd2   = 0
var int cExpire= 0
var int cRejR  = 0
var int cFill  = 0
var int foldBars = 0
if inFold
    foldBars += 1

ptv = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

bucketOf(rm) =>
    na(rm) ? 8 : rm < 0.5 ? 0 : rm < 1.0 ? 1 : rm < 1.5 ? 2 : rm < 2.0 ? 3 : rm < 3.0 ? 4 : rm < 5.0 ? 5 : rm < 10.0 ? 6 : 7

record(i) =>
    r  = array.get(rr, i)
    cR = costUSD / (r * ptv)
    v  = (array.get(flg, i) >= 1 ? tgtR : -1.0) - cR
    b  = bucketOf(array.get(rmB, i))
    array.set(bN, b, array.get(bN, b) + 1)
    array.set(bSum, b, array.get(bSum, b) + v)
    array.set(bMFE, b, array.get(bMFE, b) + array.get(mfe, i))
    array.set(bMAE, b, array.get(bMAE, b) + array.get(mae, i))
    if v > 0
        array.set(bW, b, array.get(bW, b) + 1)
    array.set(st, i, 0)

for i = 0 to SP - 1
    if array.get(st, i) == 2
        e = array.get(ent, i)
        r = array.get(rr, i)
        b = array.get(bIn, i) + 1
        array.set(bIn, i, b)
        adv = isLong ? (e - low) / r  : (high - e) / r
        fav = isLong ? (high - e) / r : (e - low) / r
        if adv > array.get(mae, i)
            array.set(mae, i, adv)
        if adv >= 1.0
            record(i)
        else
            if fav > array.get(mfe, i)
                array.set(mfe, i, fav)
            if fav >= tgtR
                array.set(flg, i, 1)
                record(i)
            else if b >= maxBars
                record(i)

for i = 0 to SP - 1
    if array.get(st, i) == 1
        L  = array.get(lvl, i)
        sp = array.get(stp, i)
        hit = isLong ? low <= L : high >= L
        if hit
            r = math.abs(L - sp)
            a = array.get(aRf, i)
            ratio = r / a
            if ratio >= minRatr and ratio <= maxRatr
                tgt = isLong ? nearestAbove(L) : nearestBelow(L)
                room = na(tgt) or r <= 0 ? na : math.abs(tgt - L) / r
                array.set(st, i, 2)
                array.set(ent, i, L)
                array.set(rr, i, r)
                array.set(rmB, i, room)
                array.set(bIn, i, 0)
                array.set(mfe, i, 0.0)
                array.set(mae, i, 0.0)
                array.set(flg, i, 0)
                cFill += 1
            else
                array.set(st, i, 0)
                cRejR += 1
        else
            w = array.get(wt, i) + 1
            array.set(wt, i, w)
            if w >= retBars
                array.set(st, i, 0)
                cExpire += 1

if inFold and gotSweep and not na(atr) and atr > 0
    cSweep += 1
    cExtra += nHit - 1
    int busy = 0
    for s = 0 to SP - 1
        if array.get(st, s) != 0
            busy += 1
    if busy >= 2
        cWd2 += 1
    int fr = -1
    for s = 0 to SP - 1
        if fr < 0 and array.get(st, s) == 0
            fr := s
    if fr < 0
        cDrop8 += 1
    else
        array.set(st, fr, 1)
        array.set(lvl, fr, sLvl)
        array.set(stp, fr, isLong ? low - bufATR * atr : high + bufATR * atr)
        array.set(aRf, fr, atr)
        array.set(wt, fr, 0)

blbl(b) => b == 0 ? "room <0.5R" : b == 1 ? "0.5-1R" : b == 2 ? "1-1.5R" : b == 3 ? "1.5-2R" : b == 4 ? "2-3R" : b == 5 ? "3-5R" : b == 6 ? "5-10R" : b == 7 ? ">=10R" : "no destination"
foldName = foldSel == 0 ? "A" : foldSel == 1 ? "B" : foldSel == 2 ? "C" : foldSel == 3 ? "A+B" : "ALL"

var table tb = table.new(position.top_right, 8, 17, border_width=1)
if barstate.islast
    days = math.max(1.0, foldBars / 288.0)
    table.cell(tb, 0, 0, (isLong ? "V48 L " : "V48 S ") + foldName, text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 1, 0, "n",      text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 2, 0, "E[R]",   text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 3, 0, "win%",   text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 4, 0, "/day",   text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 5, 0, "cumN>=", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 6, 0, "cumE>=", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 7, 0, "MAE",    text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    for b = 0 to NB - 1
        n = array.get(bN, b)
        table.cell(tb, 0, b + 1, blbl(b), text_size=size.tiny)
        table.cell(tb, 1, b + 1, str.tostring(n), text_size=size.tiny)
        if n > 0
            e = array.get(bSum, b) / n
            table.cell(tb, 2, b + 1, str.tostring(e, "#.###"), text_size=size.tiny, bgcolor=e > 0 ? color.new(color.green, 50) : color.new(color.red, 50))
            table.cell(tb, 3, b + 1, str.tostring(100.0 * array.get(bW, b) / n, "#.#"), text_size=size.tiny)
            table.cell(tb, 4, b + 1, str.tostring(n / days, "#.##"), text_size=size.tiny)
            table.cell(tb, 7, b + 1, str.tostring(array.get(bMAE, b) / n, "#.##"), text_size=size.tiny)
        if b <= 7
            int    cn = 0
            float  cs = 0.0
            for k = b to 7
                cn += array.get(bN, k)
                cs += array.get(bSum, k)
            table.cell(tb, 5, b + 1, str.tostring(cn), text_size=size.tiny)
            if cn > 0
                ce = cs / cn
                table.cell(tb, 6, b + 1, str.tostring(ce, "#.###"), text_size=size.tiny, bgcolor=ce > 0 ? color.new(color.green, 50) : color.new(color.red, 50))
    table.cell(tb, 0, 10, "LEDGER", text_color=color.white, bgcolor=color.maroon, text_size=size.tiny)
    table.cell(tb, 1, 10, "sweeps " + str.tostring(cSweep), text_size=size.tiny)
    table.cell(tb, 2, 10, "extra lvls " + str.tostring(cExtra), text_size=size.tiny)
    table.cell(tb, 3, 10, "drop@8 " + str.tostring(cDrop8), text_size=size.tiny)
    table.cell(tb, 4, 10, "wouldDrop@2 " + str.tostring(cWd2), text_size=size.tiny)
    table.cell(tb, 5, 10, "expired " + str.tostring(cExpire), text_size=size.tiny)
    table.cell(tb, 6, 10, "rejR " + str.tostring(cRejR), text_size=size.tiny)
    table.cell(tb, 7, 10, "filled " + str.tostring(cFill), text_size=size.tiny)
    table.cell(tb, 0, 11, syminfo.ticker + " " + timeframe.period, text_size=size.tiny)
    table.cell(tb, 1, 11, "bars " + str.tostring(foldBars), text_size=size.tiny)
    table.cell(tb, 2, 11, "days " + str.tostring(days, "#.#"), text_size=size.tiny)
