//@version=6
// =====================================================================
// V45 F0/F6 OVERLAP LAB
//
// Question: are "liquidity sweep" (F0) and "range mean-reversion" (F6) the
// same effect wearing two names? SETUP_FAMILIES.md flagged this as unmeasured.
//
// One engine, identical machinery to the family lab (retest limit, structural
// stop, room >= 10R, 5R target, adverse-first, costs in R). Six buckets:
//
//   G0  F0 only        sweep fires, F6 conditions absent      entry = swept level
//   G1  F6 only        range extreme + low ADX, no sweep      entry = range extreme
//   G2  F0 n F6        both fire                              entry = swept level
//   G3  F0 all         = G0 + G2                              entry = swept level
//   G4  F6 all         = G1 + G5                              entry = range extreme
//   G5  F6 n F0        both fire                              entry = range extreme
//
// Plus a tag-frequency census: of every F0 arm, how often is it also at a
// range extreme / in low ADX / HTF-aligned / reclaimed / displaced; and of
// every F6 arm, how often is a sweep present.
// =====================================================================
indicator("V45 OVERLAP LAB", overlay=true)

dirMode  = input.int(1,  "direction 1=long -1=short", minval=-1, maxval=1, group="Test")
roomMin  = input.float(10.0, "min room to destination (R)", group="Test")
tgtR     = input.float(5.0,  "target (R)", group="Test")
htfRes   = input.string("240", "HTF for bias", group="Context")
adxMax   = input.float(20.0, "F6 max ADX (range regime)", group="F6")
rngLen   = input.int(20, "F6 range lookback", group="F6")
bufATR   = input.float(0.20, "stop buffer (xATR)", group="Setup")
minWick  = input.float(0.10, "min sweep beyond level (xATR)", group="Setup")
recATR   = input.float(0.25, "reclaim strength (xATR)", group="Setup")
dispMin  = input.float(1.50, "displacement range (xATR)", group="Setup")
dispWait = input.int(12,  "bars sweep->displacement", group="Setup")
retBars  = input.int(24,  "retest window (bars)", group="Setup")
minRatr  = input.float(0.05, "min R (xATR)", group="Setup")
maxRatr  = input.float(3.00, "max R (xATR)", group="Setup")
maxBars  = input.int(144, "timeout bars", group="Setup")
costUSD  = input.float(3.00, "execution drag ($)", group="Setup")
swLen    = input.int(10,  "swing pivot len", group="Levels")

atr = ta.atr(14)
isLong = dirMode == 1
[dip, dim, adxv] = ta.dmi(14, 14)

hE20 = request.security(syminfo.tickerid, htfRes, ta.ema(close, 20)[1], lookahead=barmerge.lookahead_off)
hE50 = request.security(syminfo.tickerid, htfRes, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)
biasUp = not na(hE20) and not na(hE50) and hE20 > hE50
biasOK = isLong ? biasUp : not biasUp

newD = ta.change(time("D")) != 0
var float pdh = na
var float pdl = na
var float dh  = na
var float dl  = na
if newD
    pdh := dh
    pdl := dl
    dh  := high
    dl  := low
else
    dh := math.max(nz(dh, high), high)
    dl := math.min(nz(dl, low), low)

hUTC = hour(time, "UTC")
inAsia = hUTC < 7
var float asiaH = na
var float asiaL = na
var bool  asiaOn = false
if inAsia and not asiaOn
    asiaOn := true
    asiaH := high
    asiaL := low
else if inAsia
    asiaH := math.max(nz(asiaH, high), high)
    asiaL := math.min(nz(asiaL, low), low)
else
    asiaOn := false

ph = ta.pivothigh(high, swLen, swLen)
pl = ta.pivotlow(low,  swLen, swLen)
var float swH = na
var float swL = na
if not na(ph)
    swH := ph
if not na(pl)
    swL := pl

// ---------- F0: liquidity sweep on the direction-relevant side ----------
f0Fire = false
float f0Lvl = na
if not na(atr) and atr > 0
    if isLong
        if not na(pdl) and low < pdl - minWick * atr and close > pdl
            f0Fire := true
            f0Lvl := pdl
        else if not na(asiaL) and low < asiaL - minWick * atr and close > asiaL
            f0Fire := true
            f0Lvl := asiaL
        else if not na(swL) and low < swL - minWick * atr and close > swL
            f0Fire := true
            f0Lvl := swL
    else
        if not na(pdh) and high > pdh + minWick * atr and close < pdh
            f0Fire := true
            f0Lvl := pdh
        else if not na(asiaH) and high > asiaH + minWick * atr and close < asiaH
            f0Fire := true
            f0Lvl := asiaH
        else if not na(swH) and high > swH + minWick * atr and close < swH
            f0Fire := true
            f0Lvl := swH

// ---------- F6: range extreme in a low-ADX regime ----------
rngLo = ta.lowest(low,  rngLen)[1]
rngHi = ta.highest(high, rngLen)[1]
atExtreme = isLong ? (not na(rngLo) and low <= rngLo) : (not na(rngHi) and high >= rngHi)
lowADX = not na(adxv) and adxv < adxMax
f6Fire = atExtreme and lowADX and not na(atr) and atr > 0
float f6Lvl = isLong ? rngLo : rngHi

// ---------- sweep memory for the tag census ----------
var float swpLvl = na
var int   swpBar = -99999
var bool  swpRec = false
if f0Fire
    swpLvl := f0Lvl
    swpBar := bar_index
    swpRec := isLong ? close > f0Lvl + recATR * atr : close < f0Lvl - recATR * atr
else if not swpRec and not na(swpLvl) and bar_index - swpBar <= dispWait
    swpRec := isLong ? close > swpLvl + recATR * atr : close < swpLvl - recATR * atr

rng = high - low
dispNow = not na(atr) and rng > dispMin * atr and (isLong ? close > low + 0.6 * rng : close < low + 0.4 * rng)
freshSweep = not na(swpLvl) and (bar_index - swpBar) <= dispWait
sweepRecent = freshSweep

nearestAbove(px) =>
    float b = na
    if not na(pdh) and pdh > px
        b := pdh
    if not na(asiaH) and asiaH > px
        b := na(b) ? asiaH : math.min(b, asiaH)
    if not na(swH) and swH > px
        b := na(b) ? swH : math.min(b, swH)
    b
nearestBelow(px) =>
    float b = na
    if not na(pdl) and pdl < px
        b := pdl
    if not na(asiaL) and asiaL < px
        b := na(b) ? asiaL : math.max(b, asiaL)
    if not na(swL) and swL < px
        b := na(b) ? swL : math.max(b, swL)
    b

// ---------- engine: 6 buckets x 2 slots ----------
SP = 2
NG = 6
TOT = 12
var int[]   st   = array.new_int(TOT, 0)
var float[] lvl  = array.new_float(TOT, na)
var float[] stp  = array.new_float(TOT, na)
var float[] ent  = array.new_float(TOT, na)
var float[] rr   = array.new_float(TOT, na)
var float[] aRf  = array.new_float(TOT, na)
var int[]   wt   = array.new_int(TOT, 0)
var int[]   bIn  = array.new_int(TOT, 0)
var float[] mfe  = array.new_float(TOT, 0.0)
var float[] mae  = array.new_float(TOT, 0.0)
var int[]   flg  = array.new_int(TOT, 0)

var int[]   cN   = array.new_int(NG, 0)
var int[]   cW   = array.new_int(NG, 0)
var float[] cSum = array.new_float(NG, 0.0)
var float[] cWin = array.new_float(NG, 0.0)
var float[] cLos = array.new_float(NG, 0.0)
var float[] cMFE = array.new_float(NG, 0.0)
var float[] cMAE = array.new_float(NG, 0.0)
var float[] cRat = array.new_float(NG, 0.0)
var int[]   cArm = array.new_int(NG, 0)

// tag census: 0=F0 arms 1=&extreme 2=&lowADX 3=&f6Fire 4=&htf 5=&reclaim 6=&disp
//             7=F6 arms 8=&sweepRecent 9=&htf 10=&f0Fire
var int[]   tg = array.new_int(12, 0)
bump(i) => array.set(tg, i, array.get(tg, i) + 1)

ptv = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

record(i) =>
    g  = int(math.floor(i / SP))
    r  = array.get(rr, i)
    cR = costUSD / (r * ptv)
    v  = (array.get(flg, i) >= 1 ? tgtR : -1.0) - cR
    array.set(cN, g, array.get(cN, g) + 1)
    array.set(cSum, g, array.get(cSum, g) + v)
    array.set(cMFE, g, array.get(cMFE, g) + array.get(mfe, i))
    array.set(cMAE, g, array.get(cMAE, g) + array.get(mae, i))
    array.set(cRat, g, array.get(cRat, g) + r / array.get(aRf, i))
    if v > 0
        array.set(cW, g, array.get(cW, g) + 1)
        array.set(cWin, g, array.get(cWin, g) + v)
    else
        array.set(cLos, g, array.get(cLos, g) + v)
    array.set(st, i, 0)

for i = 0 to TOT - 1
    if array.get(st, i) == 2
        e = array.get(ent, i)
        r = array.get(rr, i)
        b = array.get(bIn, i) + 1
        array.set(bIn, i, b)
        adv = isLong ? (e - low) / r  : (high - e) / r
        fav = isLong ? (high - e) / r : (e - low) / r
        if adv > array.get(mae, i)
            array.set(mae, i, adv)
        if adv >= 1.0
            record(i)
        else
            if fav > array.get(mfe, i)
                array.set(mfe, i, fav)
            if fav >= tgtR
                array.set(flg, i, 1)
                record(i)
            else if b >= maxBars
                record(i)

for i = 0 to TOT - 1
    if array.get(st, i) == 1
        L  = array.get(lvl, i)
        sp = array.get(stp, i)
        hit = isLong ? low <= L : high >= L
        if hit
            r = math.abs(L - sp)
            a = array.get(aRf, i)
            ratio = r / a
            tgt = isLong ? nearestAbove(L) : nearestBelow(L)
            room = na(tgt) or r <= 0 ? na : math.abs(tgt - L) / r
            if ratio >= minRatr and ratio <= maxRatr and not na(room) and room >= roomMin
                array.set(st, i, 2)
                array.set(ent, i, L)
                array.set(rr, i, r)
                array.set(bIn, i, 0)
                array.set(mfe, i, 0.0)
                array.set(mae, i, 0.0)
                array.set(flg, i, 0)
            else
                array.set(st, i, 0)
        else
            w = array.get(wt, i) + 1
            array.set(wt, i, w)
            if w >= retBars
                array.set(st, i, 0)

arm(g, entLvl, stpLvl) =>
    array.set(cArm, g, array.get(cArm, g) + 1)
    int fr = -1
    for s = 0 to SP - 1
        if fr < 0 and array.get(st, g * SP + s) == 0
            fr := g * SP + s
    if fr >= 0
        array.set(st, fr, 1)
        array.set(lvl, fr, entLvl)
        array.set(stp, fr, stpLvl)
        array.set(aRf, fr, atr)
        array.set(wt, fr, 0)

if not na(atr) and atr > 0
    stpF0 = isLong ? low - bufATR * atr : high + bufATR * atr
    stpF6 = isLong ? low - bufATR * atr : high + bufATR * atr
    if f0Fire
        bump(0)
        if atExtreme
            bump(1)
        if lowADX
            bump(2)
        if f6Fire
            bump(3)
        if biasOK
            bump(4)
        if swpRec
            bump(5)
        if dispNow
            bump(6)
        arm(3, f0Lvl, stpF0)
        if f6Fire
            arm(2, f0Lvl, stpF0)
        else
            arm(0, f0Lvl, stpF0)
    if f6Fire
        bump(7)
        if sweepRecent
            bump(8)
        if biasOK
            bump(9)
        if f0Fire
            bump(10)
        arm(4, f6Lvl, stpF6)
        if f0Fire
            arm(5, f6Lvl, stpF6)
        else
            arm(1, f6Lvl, stpF6)

glbl(g) => g == 0 ? "G0 F0 only" : g == 1 ? "G1 F6 only" : g == 2 ? "G2 F0nF6 @F0" : g == 3 ? "G3 F0 all" : g == 4 ? "G4 F6 all" : "G5 F6nF0 @F6"

var table tb = table.new(position.top_right, 10, 14, border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, isLong ? "V45 OVERLAP L" : "V45 OVERLAP S", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 1, 0, "armed", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 2, 0, "n",     text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 3, 0, "E[R]",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 4, 0, "win%",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 5, 0, "PF",    text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 6, 0, "MFE",   text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 7, 0, "MAE",   text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 8, 0, "R/ATR", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 9, 0, "/day",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    days = math.max(1.0, bar_index / 288.0)
    for g = 0 to NG - 1
        n = array.get(cN, g)
        table.cell(tb, 0, g + 1, glbl(g), text_size=size.tiny)
        table.cell(tb, 1, g + 1, str.tostring(array.get(cArm, g)), text_size=size.tiny)
        table.cell(tb, 2, g + 1, str.tostring(n), text_size=size.tiny)
        if n > 0
            e = array.get(cSum, g) / n
            w = array.get(cW, g)
            gl = math.abs(array.get(cLos, g))
            table.cell(tb, 3, g + 1, str.tostring(e, "#.###"), text_size=size.tiny, bgcolor=e > 0 ? color.new(color.green, 50) : color.new(color.red, 50))
            table.cell(tb, 4, g + 1, str.tostring(100.0 * w / n, "#.#"), text_size=size.tiny)
            table.cell(tb, 5, g + 1, gl > 0 ? str.tostring(array.get(cWin, g) / gl, "#.##") : "-", text_size=size.tiny)
            table.cell(tb, 6, g + 1, str.tostring(array.get(cMFE, g) / n, "#.##"), text_size=size.tiny)
            table.cell(tb, 7, g + 1, str.tostring(array.get(cMAE, g) / n, "#.##"), text_size=size.tiny)
            table.cell(tb, 8, g + 1, str.tostring(array.get(cRat, g) / n, "#.##"), text_size=size.tiny)
            table.cell(tb, 9, g + 1, str.tostring(n / days, "#.##"), text_size=size.tiny)
    // tag census rows
    f0n = math.max(1, array.get(tg, 0))
    f6n = math.max(1, array.get(tg, 7))
    table.cell(tb, 0, 8, "TAGS on F0 arms n=" + str.tostring(array.get(tg, 0)), text_color=color.white, bgcolor=color.maroon, text_size=size.tiny)
    table.cell(tb, 1, 8, "extreme", text_size=size.tiny)
    table.cell(tb, 2, 8, str.tostring(100.0 * array.get(tg, 1) / f0n, "#.#"), text_size=size.tiny)
    table.cell(tb, 3, 8, "lowADX", text_size=size.tiny)
    table.cell(tb, 4, 8, str.tostring(100.0 * array.get(tg, 2) / f0n, "#.#"), text_size=size.tiny)
    table.cell(tb, 5, 8, "isF6", text_size=size.tiny)
    table.cell(tb, 6, 8, str.tostring(100.0 * array.get(tg, 3) / f0n, "#.#"), text_size=size.tiny)
    table.cell(tb, 0, 9, "  cont. conditions", text_size=size.tiny)
    table.cell(tb, 1, 9, "htfAlign", text_size=size.tiny)
    table.cell(tb, 2, 9, str.tostring(100.0 * array.get(tg, 4) / f0n, "#.#"), text_size=size.tiny)
    table.cell(tb, 3, 9, "reclaim", text_size=size.tiny)
    table.cell(tb, 4, 9, str.tostring(100.0 * array.get(tg, 5) / f0n, "#.#"), text_size=size.tiny)
    table.cell(tb, 5, 9, "disp", text_size=size.tiny)
    table.cell(tb, 6, 9, str.tostring(100.0 * array.get(tg, 6) / f0n, "#.#"), text_size=size.tiny)
    table.cell(tb, 0, 10, "TAGS on F6 arms n=" + str.tostring(array.get(tg, 7)), text_color=color.white, bgcolor=color.maroon, text_size=size.tiny)
    table.cell(tb, 1, 10, "sweep<=12b", text_size=size.tiny)
    table.cell(tb, 2, 10, str.tostring(100.0 * array.get(tg, 8) / f6n, "#.#"), text_size=size.tiny)
    table.cell(tb, 3, 10, "htfAlign", text_size=size.tiny)
    table.cell(tb, 4, 10, str.tostring(100.0 * array.get(tg, 9) / f6n, "#.#"), text_size=size.tiny)
    table.cell(tb, 5, 10, "isF0", text_size=size.tiny)
    table.cell(tb, 6, 10, str.tostring(100.0 * array.get(tg, 10) / f6n, "#.#"), text_size=size.tiny)
    table.cell(tb, 0, 11, syminfo.ticker + " " + timeframe.period, text_size=size.tiny)
    table.cell(tb, 1, 11, "adx<" + str.tostring(adxMax, "#"), text_size=size.tiny)
    table.cell(tb, 2, 11, "room>=" + str.tostring(roomMin, "#"), text_size=size.tiny)
