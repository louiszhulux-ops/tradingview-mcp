//@version=6
// V49 MEASUREMENT-ENGINE FIX
//
// Strategy logic is IDENTICAL to V48. Only the measurement engine changes:
//
//   1. The first-match cascade is removed. A bar that sweeps a previous-day
//      level AND an Asia level AND a pivot now emits THREE independent
//      candidates instead of one.
//   2. Slot pool raised 8 -> 24 so the extra candidates are not silently lost.
//      Contention is reported at 24, 8 and 2 slots plus observed max concurrency.
//   3. Every candidate carries a flag for whether it is the one V48's cascade
//      would have picked, so V48-equivalent and all-levels results come out of
//      the SAME run on the SAME bars.
//
// Unchanged: sweep definition, stop, entry, retest window, R cap, room buckets,
// target, timeout, cost. No room threshold applied. No bias filter. No new
// filters, families or parameters.
indicator("V49 MULTI-LEVEL LEDGER", overlay=true)

dirMode  = input.int(1,  "direction 1=long -1=short", minval=-1, maxval=1, group="Test")
foldSel  = input.int(3,  "fold 0=A 1=B 2=C 3=A+B 4=all", minval=0, maxval=4, group="Test")
tgtR     = input.float(5.0,  "target (R)", group="Setup")
bufATR   = input.float(0.20, "stop buffer (xATR)", group="Setup")
minWick  = input.float(0.10, "min sweep (xATR)", group="Setup")
retBars  = input.int(24,  "retest window", group="Setup")
minRatr  = input.float(0.05, "min R (xATR)", group="Setup")
maxRatr  = input.float(3.00, "max R (xATR)", group="Setup")
maxBars  = input.int(144, "timeout bars", group="Setup")
costUSD  = input.float(3.00, "drag ($)", group="Setup")
swLen    = input.int(10,  "swing pivot len", group="Levels")

FB = 1784160000000
FC = 1786233600000
FE = 1788134400000
inFold = foldSel == 0 ? (time < FB) : foldSel == 1 ? (time >= FB and time < FC) : foldSel == 2 ? (time >= FC and time < FE) : foldSel == 3 ? (time < FC) : (time < FE)

atr = ta.atr(14)
isLong = dirMode == 1

newD = ta.change(time("D")) != 0
var float pdh = na
var float pdl = na
var float dh  = na
var float dl  = na
if newD
    pdh := dh
    pdl := dl
    dh  := high
    dl  := low
else
    dh := math.max(nz(dh, high), high)
    dl := math.min(nz(dl, low), low)

hUTC = hour(time, "UTC")
inAsia = hUTC < 7
var float asiaH = na
var float asiaL = na
var bool  asiaOn = false
if inAsia and not asiaOn
    asiaOn := true
    asiaH := high
    asiaL := low
else if inAsia
    asiaH := math.max(nz(asiaH, high), high)
    asiaL := math.min(nz(asiaL, low), low)
else
    asiaOn := false

ph5 = ta.pivothigh(high, swLen, swLen)
pl5 = ta.pivotlow(low,  swLen, swLen)
var float swH = na
var float swL = na
if not na(ph5)
    swH := ph5
if not na(pl5)
    swL := pl5

hitPD = false
hitAS = false
hitSW = false
if not na(atr) and atr > 0
    if isLong
        hitPD := not na(pdl) and low < pdl - minWick * atr and close > pdl
        hitAS := not na(asiaL) and low < asiaL - minWick * atr and close > asiaL
        hitSW := not na(swL) and low < swL - minWick * atr and close > swL
    else
        hitPD := not na(pdh) and high > pdh + minWick * atr and close < pdh
        hitAS := not na(asiaH) and high > asiaH + minWick * atr and close < asiaH
        hitSW := not na(swH) and high > swH + minWick * atr and close < swH
nHit = (hitPD ? 1 : 0) + (hitAS ? 1 : 0) + (hitSW ? 1 : 0)

lvlPD = isLong ? pdl : pdh
lvlAS = isLong ? asiaL : asiaH
lvlSW = isLong ? swL : swH

nearestAbove(px) =>
    float b = na
    if not na(pdh) and pdh > px
        b := pdh
    if not na(asiaH) and asiaH > px
        b := na(b) ? asiaH : math.min(b, asiaH)
    if not na(swH) and swH > px
        b := na(b) ? swH : math.min(b, swH)
    b
nearestBelow(px) =>
    float b = na
    if not na(pdl) and pdl < px
        b := pdl
    if not na(asiaL) and asiaL < px
        b := na(b) ? asiaL : math.max(b, asiaL)
    if not na(swL) and swL < px
        b := na(b) ? swL : math.max(b, swL)
    b

SP = 24
var int[]   st   = array.new_int(SP, 0)
var float[] lvl  = array.new_float(SP, na)
var float[] stp  = array.new_float(SP, na)
var float[] ent  = array.new_float(SP, na)
var float[] rr   = array.new_float(SP, na)
var float[] aRf  = array.new_float(SP, na)
var float[] rmB  = array.new_float(SP, na)
var int[]   wt   = array.new_int(SP, 0)
var int[]   bIn  = array.new_int(SP, 0)
var float[] mfe  = array.new_float(SP, 0.0)
var float[] mae  = array.new_float(SP, 0.0)
var int[]   flg  = array.new_int(SP, 0)
var int[]   fst  = array.new_int(SP, 0)

NB = 9
var int[]   aN   = array.new_int(NB, 0)
var int[]   aW   = array.new_int(NB, 0)
var float[] aS   = array.new_float(NB, 0.0)
var int[]   fN   = array.new_int(NB, 0)
var int[]   fW   = array.new_int(NB, 0)
var float[] fS   = array.new_float(NB, 0.0)

var int cBars  = 0
var int cPD    = 0
var int cAS    = 0
var int cSW    = 0
var int cM2    = 0
var int cM3    = 0
var int cExpire= 0
var int cRejR  = 0
var int cFill  = 0
// capacity counters live in an array: Pine cannot assign a global inside a function
// 0 candidates, 1 dropped at 24, 2 would-drop at 8, 3 would-drop at 2, 4 max concurrent
var int[] cap = array.new_int(5, 0)
var int foldBars = 0
if inFold
    foldBars += 1

ptv = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

bucketOf(rm) =>
    na(rm) ? 8 : rm < 0.5 ? 0 : rm < 1.0 ? 1 : rm < 1.5 ? 2 : rm < 2.0 ? 3 : rm < 3.0 ? 4 : rm < 5.0 ? 5 : rm < 10.0 ? 6 : 7

record(i) =>
    r  = array.get(rr, i)
    cR = costUSD / (r * ptv)
    v  = (array.get(flg, i) >= 1 ? tgtR : -1.0) - cR
    b  = bucketOf(array.get(rmB, i))
    array.set(aN, b, array.get(aN, b) + 1)
    array.set(aS, b, array.get(aS, b) + v)
    if v > 0
        array.set(aW, b, array.get(aW, b) + 1)
    if array.get(fst, i) == 1
        array.set(fN, b, array.get(fN, b) + 1)
        array.set(fS, b, array.get(fS, b) + v)
        if v > 0
            array.set(fW, b, array.get(fW, b) + 1)
    array.set(st, i, 0)

for i = 0 to SP - 1
    if array.get(st, i) == 2
        e = array.get(ent, i)
        r = array.get(rr, i)
        b = array.get(bIn, i) + 1
        array.set(bIn, i, b)
        adv = isLong ? (e - low) / r  : (high - e) / r
        fav = isLong ? (high - e) / r : (e - low) / r
        if adv > array.get(mae, i)
            array.set(mae, i, adv)
        if adv >= 1.0
            record(i)
        else
            if fav > array.get(mfe, i)
                array.set(mfe, i, fav)
            if fav >= tgtR
                array.set(flg, i, 1)
                record(i)
            else if b >= maxBars
                record(i)

for i = 0 to SP - 1
    if array.get(st, i) == 1
        L  = array.get(lvl, i)
        sp = array.get(stp, i)
        hit = isLong ? low <= L : high >= L
        if hit
            r = math.abs(L - sp)
            a = array.get(aRf, i)
            ratio = r / a
            if ratio >= minRatr and ratio <= maxRatr
                tgt = isLong ? nearestAbove(L) : nearestBelow(L)
                room = na(tgt) or r <= 0 ? na : math.abs(tgt - L) / r
                array.set(st, i, 2)
                array.set(ent, i, L)
                array.set(rr, i, r)
                array.set(rmB, i, room)
                array.set(bIn, i, 0)
                array.set(mfe, i, 0.0)
                array.set(mae, i, 0.0)
                array.set(flg, i, 0)
                cFill += 1
            else
                array.set(st, i, 0)
                cRejR += 1
        else
            w = array.get(wt, i) + 1
            array.set(wt, i, w)
            if w >= retBars
                array.set(st, i, 0)
                cExpire += 1

busyNow() =>
    int b = 0
    for s = 0 to SP - 1
        if array.get(st, s) != 0
            b += 1
    b

armOne(entLvl, stpLvl, isFirst) =>
    array.set(cap, 0, array.get(cap, 0) + 1)
    bz = busyNow()
    if bz > array.get(cap, 4)
        array.set(cap, 4, bz)
    if bz >= 2
        array.set(cap, 3, array.get(cap, 3) + 1)
    if bz >= 8
        array.set(cap, 2, array.get(cap, 2) + 1)
    int fr = -1
    for s = 0 to SP - 1
        if fr < 0 and array.get(st, s) == 0
            fr := s
    if fr < 0
        array.set(cap, 1, array.get(cap, 1) + 1)
    else
        array.set(st, fr, 1)
        array.set(lvl, fr, entLvl)
        array.set(stp, fr, stpLvl)
        array.set(aRf, fr, atr)
        array.set(wt, fr, 0)
        array.set(fst, fr, isFirst ? 1 : 0)

if inFold and nHit > 0 and not na(atr) and atr > 0
    cBars += 1
    if nHit == 2
        cM2 += 1
    if nHit == 3
        cM3 += 1
    sp = isLong ? low - bufATR * atr : high + bufATR * atr
    if hitPD
        cPD += 1
        armOne(lvlPD, sp, true)
    if hitAS
        cAS += 1
        armOne(lvlAS, sp, not hitPD)
    if hitSW
        cSW += 1
        armOne(lvlSW, sp, not hitPD and not hitAS)

blbl(b) => b == 0 ? "room <0.5R" : b == 1 ? "0.5-1R" : b == 2 ? "1-1.5R" : b == 3 ? "1.5-2R" : b == 4 ? "2-3R" : b == 5 ? "3-5R" : b == 6 ? "5-10R" : b == 7 ? ">=10R" : "no dest"
foldName = foldSel == 0 ? "A" : foldSel == 1 ? "B" : foldSel == 2 ? "C" : foldSel == 3 ? "A+B" : "ALL"

var table tb = table.new(position.top_right, 8, 16, border_width=1)
if barstate.islast
    days = math.max(1.0, foldBars / 288.0)
    table.cell(tb, 0, 0, (isLong ? "V49 L " : "V49 S ") + foldName, text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 1, 0, "nALL",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 2, 0, "E ALL", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 3, 0, "nV48",  text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 4, 0, "E V48", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 5, 0, "cumALL",text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 6, 0, "cumV48",text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 7, 0, "win%A", text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    for b = 0 to NB - 1
        na_ = array.get(aN, b)
        nf_ = array.get(fN, b)
        table.cell(tb, 0, b + 1, blbl(b), text_size=size.tiny)
        table.cell(tb, 1, b + 1, str.tostring(na_), text_size=size.tiny)
        table.cell(tb, 3, b + 1, str.tostring(nf_), text_size=size.tiny)
        if na_ > 0
            e = array.get(aS, b) / na_
            table.cell(tb, 2, b + 1, str.tostring(e, "#.###"), text_size=size.tiny, bgcolor=e > 0 ? color.new(color.green, 50) : color.new(color.red, 50))
            table.cell(tb, 7, b + 1, str.tostring(100.0 * array.get(aW, b) / na_, "#.#"), text_size=size.tiny)
        if nf_ > 0
            e2 = array.get(fS, b) / nf_
            table.cell(tb, 4, b + 1, str.tostring(e2, "#.###"), text_size=size.tiny, bgcolor=e2 > 0 ? color.new(color.green, 50) : color.new(color.red, 50))
        if b <= 7
            int   ca = 0
            float sa = 0.0
            int   cf = 0
            float sf = 0.0
            for k = b to 7
                ca += array.get(aN, k)
                sa += array.get(aS, k)
                cf += array.get(fN, k)
                sf += array.get(fS, k)
            table.cell(tb, 5, b + 1, ca > 0 ? str.tostring(sa / ca, "#.###") + " n" + str.tostring(ca) : "-", text_size=size.tiny)
            table.cell(tb, 6, b + 1, cf > 0 ? str.tostring(sf / cf, "#.###") + " n" + str.tostring(cf) : "-", text_size=size.tiny)
    table.cell(tb, 0, 10, "DETECTION", text_color=color.white, bgcolor=color.maroon, text_size=size.tiny)
    table.cell(tb, 1, 10, "sweepBars " + str.tostring(cBars), text_size=size.tiny)
    table.cell(tb, 2, 10, "cands " + str.tostring(array.get(cap, 0)), text_size=size.tiny)
    table.cell(tb, 3, 10, "prevDay " + str.tostring(cPD), text_size=size.tiny)
    table.cell(tb, 4, 10, "asia " + str.tostring(cAS), text_size=size.tiny)
    table.cell(tb, 5, 10, "pivot " + str.tostring(cSW), text_size=size.tiny)
    table.cell(tb, 6, 10, "bars2lvl " + str.tostring(cM2), text_size=size.tiny)
    table.cell(tb, 7, 10, "bars3lvl " + str.tostring(cM3), text_size=size.tiny)
    table.cell(tb, 0, 11, "CAPACITY", text_color=color.white, bgcolor=color.maroon, text_size=size.tiny)
    table.cell(tb, 1, 11, "drop@24 " + str.tostring(array.get(cap, 1)), text_size=size.tiny)
    table.cell(tb, 2, 11, "wdrop@8 " + str.tostring(array.get(cap, 2)), text_size=size.tiny)
    table.cell(tb, 3, 11, "wdrop@2 " + str.tostring(array.get(cap, 3)), text_size=size.tiny)
    table.cell(tb, 4, 11, "maxConc " + str.tostring(array.get(cap, 4)), text_size=size.tiny)
    table.cell(tb, 5, 11, "expired " + str.tostring(cExpire), text_size=size.tiny)
    table.cell(tb, 6, 11, "rejR " + str.tostring(cRejR), text_size=size.tiny)
    table.cell(tb, 7, 11, "filled " + str.tostring(cFill), text_size=size.tiny)
    table.cell(tb, 0, 12, syminfo.ticker + " " + timeframe.period, text_size=size.tiny)
    table.cell(tb, 1, 12, "bars " + str.tostring(foldBars), text_size=size.tiny)
    table.cell(tb, 2, 12, "days " + str.tostring(days, "#.#"), text_size=size.tiny)
