//@version=6
// =====================================================================
// V17 SWEEP -- liquidity sweep + reclaim, STRUCTURAL stop, hard $ cap
//
// V16 measured the real blocker: a 3xATR stop on 1H gold is ~$87, so one
// MGC contract risks $868 = 1.74% of a 50K account against a $2,000 MLL,
// i.e. 2.3R of total buffer. Nothing survives that. The user's own trades
// take a $10 stop: $100 per contract, 20R of buffer. The difference is the
// invalidation point, not the entry signal.
//
// So: take the stop from the swept extreme and REJECT any setup whose
// structural stop is wider than maxStopUSD rather than sizing down into it.
//
// TWO EXECUTION BUGS FOUND AND FIXED HERE:
//  1. strategy.position_size is still 0 on the bar the entry is submitted, so
//     an exit guarded by `if strategy.position_size > 0` is not placed until
//     the NEXT bar, leaving the first bar unprotected. With a $2-12 stop that
//     is fatal. The exit is now armed on the same bar as the entry.
//  2. strategy.close_all() fills at the NEXT bar's open, so a flat triggered
//     on the session-end bar of a Friday actually executes at Sunday's open.
//     The two worst losses in the sample (-$2,088 and -$1,665) were exactly
//     that: Friday entries exited at Sunday's open, together 65% of max
//     drawdown. The flat now fires on a separate, earlier window so the
//     order fills while the market is still liquid.
// =====================================================================
strategy("V17 SWEEP", overlay=true,
     initial_capital=50000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1,
     pyramiding=1,
     commission_type=strategy.commission.cash_per_order, commission_value=1.24,
     slippage=2,
     margin_long=5, margin_short=5,
     max_labels_count=500)

sideIn     = input.int(1,   "side 1both 2long 3short", minval=1, maxval=3, group="Setup")
pivL       = input.int(5,   "pivot left",  group="Setup")
pivR       = input.int(3,   "pivot right", group="Setup")
reclaimBar = input.int(6,   "max bars sweep -> reclaim", group="Setup")

maxStopUSD = input.float(12.0, "MAX stop distance ($)", group="Stop")
minStopUSD = input.float(2.0,  "min stop distance ($)", group="Stop")
bufUSD     = input.float(1.0,  "buffer beyond swept extreme ($)", group="Stop")

tpR        = input.float(3.0,  "target (R); 0 = none", group="Exit")
useTrail   = input.bool(false, "trail instead of fixed target", group="Exit")
trailR     = input.float(1.0,  "trail offset (R)", group="Exit")
beAtR      = input.float(0.0,  "move stop to BE at (R); 0 = off", group="Exit")
flatEOD    = input.bool(true,  "flat at end of flat-window", group="Exit")

useSess    = input.bool(true,  "entry session filter", group="Session")
sessStr    = input.session("1300-2100", "entry session (UTC)", group="Session")
flatStr    = input.session("1300-1930", "must-be-flat-by window (UTC)", group="Session")

riskUSD    = input.float(500,  "risk per trade ($)", group="Risk")
maxCtr     = input.int(400,    "max units (40 MGC = 400 oz)", group="Risk")

startTime  = input.time(timestamp("2025-10-01 00:00 +0000"), "Start (UTC)", group="Window")
endTime    = input.time(timestamp("2026-09-03 23:59 +0000"), "End (UTC)",   group="Window")
doExport   = input.bool(false, "export trades as labels", group="Export")

inWin   = time >= startTime and time <= endTime
sessOn  = not na(time(timeframe.period, sessStr, "UTC"))
flatOn  = not na(time(timeframe.period, flatStr, "UTC"))
inSess  = not useSess or sessOn
ptVal   = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue

ph = ta.pivothigh(high, pivL, pivR)
pl = ta.pivotlow(low,  pivL, pivR)

var float swLo = na
var float swHi = na
var bool  sweptLo = false
var bool  sweptHi = false
var float sweepLoPx = na
var float sweepHiPx = na
var int   sweepLoBar = 0
var int   sweepHiBar = 0

if not na(pl)
    swLo      := pl
    sweptLo   := false
    sweepLoPx := na
if not na(ph)
    swHi      := ph
    sweptHi   := false
    sweepHiPx := na

if not na(swLo) and low < swLo
    sweptLo    := true
    sweepLoPx  := na(sweepLoPx) ? low : math.min(sweepLoPx, low)
    sweepLoBar := bar_index
if not na(swHi) and high > swHi
    sweptHi    := true
    sweepHiPx  := na(sweepHiPx) ? high : math.max(sweepHiPx, high)
    sweepHiBar := bar_index

reclaimL = sweptLo and not na(swLo) and close > swLo and (bar_index - sweepLoBar) <= reclaimBar
reclaimS = sweptHi and not na(swHi) and close < swHi and (bar_index - sweepHiBar) <= reclaimBar

stopL = sweepLoPx - bufUSD
stopS = sweepHiPx + bufUSD
dL    = close - stopL
dS    = stopS  - close

var int sigL = 0
var int sigS = 0
var int rejSide  = 0
var int rejSess  = 0
var int rejWide  = 0
var int rejTight = 0
var int rejInPos = 0
var int rejSize  = 0
var int taken    = 0
var int nFlat    = 0
var float sumStop = 0.0

var float entryPx  = na
var float entryStp = na
var float entryR   = na
var bool  beDone   = false

sizeFor(d) =>
    rpc = d * ptVal
    rpc > 0 ? math.min(math.floor(riskUSD / rpc), maxCtr) : 0

armLong(px, stp, r) =>
    if useTrail
        strategy.exit("xL", "L", stop=stp, trail_points=r/syminfo.mintick, trail_offset=trailR*r/syminfo.mintick)
    else if tpR > 0
        strategy.exit("xL", "L", stop=stp, limit=px + tpR * r)
    else
        strategy.exit("xL", "L", stop=stp)

armShort(px, stp, r) =>
    if useTrail
        strategy.exit("xS", "S", stop=stp, trail_points=r/syminfo.mintick, trail_offset=trailR*r/syminfo.mintick)
    else if tpR > 0
        strategy.exit("xS", "S", stop=stp, limit=px - tpR * r)
    else
        strategy.exit("xS", "S", stop=stp)

// entries are only allowed while the flat-window is still open, so nothing is
// opened that must immediately be closed
canEnter = inWin and inSess and (not flatEOD or flatOn)

if inWin
    if reclaimL
        sigL += 1
    if reclaimS
        sigS += 1

    okSideL = sideIn == 1 or sideIn == 2
    okSideS = sideIn == 1 or sideIn == 3

    if reclaimL
        if not okSideL
            rejSide += 1
        else if not canEnter
            rejSess += 1
        else if strategy.position_size != 0
            rejInPos += 1
        else if na(dL) or dL > maxStopUSD
            rejWide += 1
        else if dL < minStopUSD
            rejTight += 1
        else
            n = sizeFor(dL)
            if n < 1
                rejSize += 1
            else
                strategy.entry("L", strategy.long, qty=n)
                entryPx  := close
                entryStp := stopL
                entryR   := dL
                beDone   := false
                sweptLo  := false
                taken    += 1
                sumStop  += dL
                armLong(close, stopL, dL)

    if reclaimS
        if not okSideS
            rejSide += 1
        else if not canEnter
            rejSess += 1
        else if strategy.position_size != 0
            rejInPos += 1
        else if na(dS) or dS > maxStopUSD
            rejWide += 1
        else if dS < minStopUSD
            rejTight += 1
        else
            n2 = sizeFor(dS)
            if n2 < 1
                rejSize += 1
            else
                strategy.entry("S", strategy.short, qty=n2)
                entryPx  := close
                entryStp := stopS
                entryR   := dS
                beDone   := false
                sweptHi  := false
                taken    += 1
                sumStop  += dS
                armShort(close, stopS, dS)

if strategy.position_size > 0 and not na(entryStp)
    stp = entryStp
    if beAtR > 0 and (close >= entryPx + beAtR * entryR or beDone)
        beDone := true
        stp := math.max(entryStp, entryPx)
    armLong(entryPx, stp, entryR)

if strategy.position_size < 0 and not na(entryStp)
    stp2 = entryStp
    if beAtR > 0 and (close <= entryPx - beAtR * entryR or beDone)
        beDone := true
        stp2 := math.min(entryStp, entryPx)
    armShort(entryPx, stp2, entryR)

// the flat fires as soon as the flat-window closes; because close_all fills at
// the NEXT bar's open, that window ends well before the session does
if strategy.position_size != 0 and ((flatEOD and not flatOn) or time > endTime)
    strategy.close_all(comment="flat")
    nFlat += 1

var int lastN = 0
if doExport and strategy.closedtrades > lastN
    for i = lastN to strategy.closedtrades - 1
        txt = "T|" + str.tostring(i) + "|" + str.tostring(strategy.closedtrades.entry_time(i)) + "|" + str.tostring(strategy.closedtrades.exit_time(i)) + "|" + str.tostring(strategy.closedtrades.profit(i), "#.##") + "|" + str.tostring(strategy.closedtrades.size(i), "#.##") + "|" + str.tostring(strategy.closedtrades.max_runup(i), "#.##") + "|" + str.tostring(strategy.closedtrades.max_drawdown(i), "#.##")
        label.new(bar_index, high, txt, style=label.style_none, textcolor=color.new(color.white, 100), size=size.tiny)
    lastN := strategy.closedtrades

if barstate.islastconfirmedhistory or barstate.islast
    t = table.new(position.top_right, 2, 10, border_width=1)
    table.cell(t, 0, 0, "signals L/S", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 0, str.tostring(sigL) + " / " + str.tostring(sigS), bgcolor=color.gray, text_color=color.white)
    table.cell(t, 0, 1, "taken")
    table.cell(t, 1, 1, str.tostring(taken))
    table.cell(t, 0, 2, "mean stop USD")
    table.cell(t, 1, 2, str.tostring(taken > 0 ? sumStop / taken : 0, "#.##"))
    table.cell(t, 0, 3, "forced flats")
    table.cell(t, 1, 3, str.tostring(nFlat))
    table.cell(t, 0, 4, "rej session/window")
    table.cell(t, 1, 4, str.tostring(rejSess))
    table.cell(t, 0, 5, "rej in position")
    table.cell(t, 1, 5, str.tostring(rejInPos))
    table.cell(t, 0, 6, "rej stop too wide")
    table.cell(t, 1, 6, str.tostring(rejWide))
    table.cell(t, 0, 7, "rej stop too tight")
    table.cell(t, 1, 7, str.tostring(rejTight))
    table.cell(t, 0, 8, "rej wrong side")
    table.cell(t, 1, 8, str.tostring(rejSide))
    table.cell(t, 0, 9, "closed trades")
    table.cell(t, 1, 9, str.tostring(strategy.closedtrades))

plot(swLo, "swing low",  color.new(color.red, 0),  style=plot.style_stepline)
plot(swHi, "swing high", color.new(color.lime, 0), style=plot.style_stepline)
