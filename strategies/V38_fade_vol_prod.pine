//@version=6
// =====================================================================
// V38 FADE-VOL PROD -- the production engine.
//
// Signal:  fade long-side momentum triggers (short), 5m
// Filter:  ONLY when ATR(14) >= volCut x SMA(ATR,100)      [V37, validated]
// Risk:    stop 1.5xATR, target 2R, buffer-based sizing
// Rules:   LucidFlex trailing end-of-day MLL, $100 lock, 50% consistency
//
// The daily target / daily loss gates from V35 are OFF by default: V36 measured
// them cutting the sample to 14% of trades and selecting a losing subset.
//
// Every position carries its own protective stop from the bar it opens on.
// alert() fires on entry so the signal can drive forward paper trading.
// =====================================================================
strategy("V38 FADE-VOL PROD", overlay=true, initial_capital=50000,
     currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1,
     pyramiding=4, commission_type=strategy.commission.cash_per_order,
     commission_value=0.52, slippage=1, calc_on_every_tick=false)

brkLen  = input.int(20, "break lookback", group="Trigger")
swLen   = input.int(10, "swing pivot len", group="Trigger")
lookK   = input.int(6,  "sweep reclaim window", group="Trigger")
emaFL   = input.int(20, "ema fast", group="Trigger")
emaSL   = input.int(50, "ema slow", group="Trigger")
vwapM   = input.int(5,  "bars beyond vwap", group="Trigger")

volCut  = input.float(1.50, "VOL FILTER: atr / sma(atr,100) >=", group="Filter")
volLen  = input.int(100, "vol baseline length", group="Filter")

stopA   = input.float(1.5,  "stop (xATR)", group="Risk")
tgtR    = input.float(2.0,  "target (xR)", group="Risk")
bufFrac = input.float(0.055,"risk = this fraction of MLL buffer", group="Risk")
maxCtr  = input.int(40,     "max contracts", group="Risk")
maxSlot = input.int(1,      "max concurrent fades", minval=1, maxval=4, group="Risk")   // V38: 4->1 removed 21.8R of drawdown on MNQ

startBal = input.float(50000, "account start ($)", group="Prop")
mll      = input.float(2000,  "max loss limit ($)", group="Prop")
tgtUSD   = input.float(3000,  "profit target ($)", group="Prop")
lockOff  = input.float(100,   "lock offset ($)", group="Prop")
useDayT  = input.bool(false,  "use daily target gate (V36: harmful)", group="Prop")
useDayS  = input.bool(false,  "use daily loss gate (V36: harmful)", group="Prop")
dayTgtN  = input.int(8,       "spread target over N days", group="Prop")
dayStopR = input.float(8.0,   "daily stop (xRisk)", group="Prop")
research = input.bool(false,  "RESEARCH mode: no pass/bust gate, qty=1", group="Research")

atr = ta.atr(14)
eF  = ta.ema(close, emaFL)
eS  = ta.ema(close, emaSL)
vw  = ta.vwap(hlc3)

hiLvl = ta.highest(high, brkLen)[1]
brkUp = not na(hiLvl) and close > hiLvl and close[1] <= hiLvl

pl = ta.pivotlow(low, swLen, swLen)
var float lastPL = na
if not na(pl)
    lastPL := pl
var int   swpLoBar = -99999
var float swpLoLvl = na
if not na(lastPL) and low < lastPL
    swpLoBar := bar_index
    swpLoLvl := lastPL
swpUp = not na(swpLoLvl) and (bar_index - swpLoBar) <= lookK and close > swpLoLvl and close[1] <= swpLoLvl

xUpF  = ta.crossover(close, eF)
pulUp = eF > eS and xUpF
xUpV  = ta.crossover(close, vw)
bsAbv = ta.barssince(close > vw)
vwUp  = xUpV and nz(bsAbv[1], 999) >= vwapM

volr   = atr / ta.sma(atr, volLen)
volOK  = not na(volr) and volr >= volCut
fire   = (brkUp or swpUp or pulUp or vwUp) and volOK

bal    = startBal + strategy.netprofit
newD   = ta.change(time("D")) != 0
var float peakBal  = startBal
var float floorBal = startBal - mll
var bool  locked   = false
var float dayStart = startBal
var int   nDays    = 0
var float bestDay  = 0.0
var bool  passed   = false
var bool  busted   = false
var int   passBar  = 0

if newD and bar_index > 0
    dp = bal - dayStart
    if dp > bestDay
        bestDay := dp
    nDays := nDays + 1
    peakBal := math.max(peakBal, bal)
    if not locked
        floorBal := peakBal - mll
        if bal >= startBal + mll + lockOff
            locked   := true
            floorBal := startBal + lockOff
    if bal <= floorBal
        busted := true
    if not passed and not busted and bal >= startBal + tgtUSD and bestDay <= 0.5 * (bal - startBal)
        passed  := true
        passBar := nDays
    dayStart := bal

buffer  = math.max(0.0, bal - floorBal)
riskNow = bufFrac * buffer
dayPnL  = bal - dayStart
dayTgt  = tgtUSD / math.max(dayTgtN, 2)

ptVal = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue
d     = stopA * atr

sizeFor(dd) =>
    rpc = dd * ptVal
    int n = 0
    if rpc > 0
        n := int(math.floor(riskNow / rpc))
        if n < 1 and buffer > rpc * 3.0
            n := 1
        n := math.min(n, maxCtr)
    n

var bool[] slotOpen = array.new_bool(4, false)
for s = 0 to 3
    array.set(slotOpen, s, false)
if strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        eid = strategy.opentrades.entry_id(i)
        if eid == "F0"
            array.set(slotOpen, 0, true)
        else if eid == "F1"
            array.set(slotOpen, 1, true)
        else if eid == "F2"
            array.set(slotOpen, 2, true)
        else if eid == "F3"
            array.set(slotOpen, 3, true)

okDayT = not useDayT or dayPnL < dayTgt
okDayS = not useDayS or dayPnL > -dayStopR * math.max(riskNow, 1.0)
tradeOK = research ? true : (not passed and not busted and okDayT and okDayS and buffer > 0)

if fire and tradeOK and d > 0 and not na(atr)
    int free = -1
    for s = 0 to maxSlot - 1
        if free < 0 and not array.get(slotOpen, s)
            free := s
    if free >= 0
        n = research ? 1 : sizeFor(d)
        if n > 0
            sp = close + d
            tp = close - tgtR * d
            if free == 0
                strategy.entry("F0", strategy.short, qty=n)
                strategy.exit("x0", "F0", stop=sp, limit=tp)
            else if free == 1
                strategy.entry("F1", strategy.short, qty=n)
                strategy.exit("x1", "F1", stop=sp, limit=tp)
            else if free == 2
                strategy.entry("F2", strategy.short, qty=n)
                strategy.exit("x2", "F2", stop=sp, limit=tp)
            else
                strategy.entry("F3", strategy.short, qty=n)
                strategy.exit("x3", "F3", stop=sp, limit=tp)
            alert("V38 SHORT " + syminfo.ticker + " qty=" + str.tostring(n) + " stop=" + str.tostring(sp, "#.##") + " target=" + str.tostring(tp, "#.##") + " volr=" + str.tostring(volr, "#.##"), alert.freq_once_per_bar_close)

if not research and (passed or busted) and strategy.position_size != 0
    strategy.close_all(comment="eval over")

var table tb = table.new(position.top_right, 2, 13, border_width=1)
if barstate.islastconfirmedhistory or barstate.islast
    consist = bal - startBal > 0 ? bestDay / (bal - startBal) : na
    avgR = strategy.closedtrades > 0 and not na(atr) ? (strategy.netprofit / strategy.closedtrades) / (stopA * atr * ptVal) : na
    table.cell(tb, 0, 0, "V38 FADE-VOL" + (research ? " RSCH" : ""), text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 1, 0, syminfo.ticker + " " + timeframe.period, text_color=color.white, bgcolor=color.navy, text_size=size.tiny)
    table.cell(tb, 0, 1, "net profit", text_size=size.tiny)
    table.cell(tb, 1, 1, str.tostring(strategy.netprofit, "#.00"), text_size=size.tiny)
    table.cell(tb, 0, 2, "trades", text_size=size.tiny)
    table.cell(tb, 1, 2, str.tostring(strategy.closedtrades), text_size=size.tiny)
    table.cell(tb, 0, 3, "win%", text_size=size.tiny)
    table.cell(tb, 1, 3, strategy.closedtrades > 0 ? str.tostring(100.0 * strategy.wintrades / strategy.closedtrades, "#.#") : "-", text_size=size.tiny)
    table.cell(tb, 0, 4, "profit factor", text_size=size.tiny)
    table.cell(tb, 1, 4, str.tostring(strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na, "#.###"), text_size=size.tiny)
    table.cell(tb, 0, 5, "max DD", text_size=size.tiny)
    table.cell(tb, 1, 5, str.tostring(strategy.max_drawdown, "#.00"), text_size=size.tiny)
    table.cell(tb, 0, 6, "days", text_size=size.tiny)
    table.cell(tb, 1, 6, str.tostring(nDays), text_size=size.tiny)
    table.cell(tb, 0, 7, "trades/day", text_size=size.tiny)
    table.cell(tb, 1, 7, nDays > 0 ? str.tostring(strategy.closedtrades / nDays, "#.##") : "-", text_size=size.tiny)
    table.cell(tb, 0, 8, "stop $/ctr", text_size=size.tiny)
    table.cell(tb, 1, 8, str.tostring(stopA * atr * ptVal, "#.00"), text_size=size.tiny)
    table.cell(tb, 0, 9, "MLL floor", text_size=size.tiny)
    table.cell(tb, 1, 9, str.tostring(floorBal, "#.00") + (locked ? " LOCK" : ""), text_size=size.tiny)
    table.cell(tb, 0, 10, "best day / total", text_size=size.tiny)
    table.cell(tb, 1, 10, str.tostring(consist, "#.###"), text_size=size.tiny)
    table.cell(tb, 0, 11, "avg R/trade", text_size=size.tiny)
    table.cell(tb, 1, 11, str.tostring(avgR, "#.####"), text_size=size.tiny, bgcolor=na(avgR) ? color.gray : avgR > 0 ? color.new(color.green, 70) : color.new(color.red, 70))
    table.cell(tb, 0, 12, "OUTCOME", text_size=size.tiny)
    table.cell(tb, 1, 12, research ? "research" : passed ? "PASS day " + str.tostring(passBar) : busted ? "BUST" : "running", text_size=size.tiny, bgcolor=research ? color.new(color.blue, 60) : passed ? color.new(color.green, 50) : busted ? color.new(color.red, 50) : color.new(color.gray, 50))
